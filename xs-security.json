{
  "xsappname": "zictm",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Read",
      "description": "Read access"
    },
    {
      "name": "$XSAPPNAME.Create",
      "description": "Create access"
    },
    {
      "name": "$XSAPPNAME.Update",
      "description": "Update access"
    },
    {
      "name": "$XSAPPNAME.Delete",
      "description": "Delete access"
    },
    {
      "name": "$XSAPPNAME.Administrators",
      "description": "Administrators"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Administrators",
      "description": "Administrator with full access",
      "scope-references": [
        "$XSAPPNAME.Administrators",  
        "$XSAPPNAME.Read",           
        "$XSAPPNAME.Create",          
        "$XSAPPNAME.Update",          
        "$XSAPPNAME.Delete"           
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "zictm_Administrators",
      "description": "zictm Administrators",
      "role-template-references": [
        "$XSAPPNAME.Administrators"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
        "https://*.btp.sunlu3d.cn/**",
        "https://zictm.btp.sunlu3d.cn/login/callback",
        "https://*.btp-prd.sunlu3d.cn/**",
        "https://zictm.btp-prd.sunlu3d.cn/login/callback"
      ]
  }
}
