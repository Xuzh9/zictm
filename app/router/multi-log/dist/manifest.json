{
	"_version": "1.83.0",
	"sap.app": {
		"id": "multilog",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:worklist",
			"version": "1.22.0",
			"toolsId": "2c269a7a-994b-4e99-a7b9-75cdd7d6a0bb"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/multistep-log/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.01"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.147.1",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "multilog.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"controllerExtensions": {
			"sap.fe.templates.ListReport.ListReportController": {
				"controllerName": "multilog.ext.controller.ListReportExtension"
			}
		},
		"routing": {
			"config": {
				"async": true
			},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "MultistepLogList",
					"target": "MultistepLogList"
				},
				{
					"pattern": "MultistepLog({key}):?query:",
					"name": "MultistepLogObjectPage",
					"target": "MultistepLogObjectPage"
				}
			],
			"targets": {
				"MultistepLogList": {
					"type": "Component",
					"id": "MultistepLogList",
					"name": "sap.fe.templates.ListReport",
					"controlAggregation": "pages",
					"options": {
						"settings": {
							"contextPath": "/MultistepLog",
							"variantManagement": "Page",
							"hideFilterBar": true,
							"navigation": {
								"MultistepLog": {
									"detail": {
										"route": "MultistepLogObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"MultistepLogObjectPage": {
					"type": "Component",
					"id": "MultistepLogObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"controlAggregation": "pages",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/MultistepLog"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	}
}