{
  "welcomeFile": "multi-step/webapp/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/multi-step/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/mpt/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/multi-log/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/so-rel/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/dn-rel/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/bank/(.*)$",
      "localDir": ".",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}