{
  "_version": "1.85.0",
  "sap.app": {
    "id": "dnrel",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:worklist",
      "version": "1.25.0",
      "toolsId": "5bd64af8-2b0b-41ce-9771-b3349d31e51b"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/report/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "dnrel.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PIDeliveryRelList",
          "target": "PIDeliveryRelList"
        },
        {
          "pattern": "PIDeliveryRel({key}):?query:",
          "name": "PIDeliveryRelObjectPage",
          "target": "PIDeliveryRelObjectPage"
        }
      ],
      "targets": {
        "PIDeliveryRelList": {
          "type": "Component",
          "id": "PIDeliveryRelList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PIDeliveryRel",
              "variantManagement": "Page",
              "hideFilterBar": false,
              "navigation": {
                "PIDeliveryRel": {
                  "detail": {
                    "route": "PIDeliveryRelObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "rowCount": 10,
                    "rowCountMode":"auto"
                  }
                }
              }
            }
          }
        },
        "PIDeliveryRelObjectPage": {
          "type": "Component",
          "id": "PIDeliveryRelObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/PIDeliveryRel"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
