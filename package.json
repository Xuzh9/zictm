{
  "name": "zictm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@cap-js/hana": "^2.7.1",
    "@sap-cloud-sdk/connectivity": "^3.26.4",
    "@sap-cloud-sdk/http-client": "^3.26.4",
    "@sap-cloud-sdk/odata-v2": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^3.26.4",
    "@sap-cloud-sdk/util": "^3.26.4",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9.8.4",
    "@sap/xssec": "^4",
    "axios": "^1.15.0",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "start": "node server.js",
    "start:cds": "node node_modules/@sap/cds-dk/bin/cds.js run",
    "undeploy": "cf undeploy zictm --delete-services --delete-service-keys --delete-service-brokers",
    "build": "cds build --production",
    "build:mta": "mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "build:mta:dev": "mbt build --mtar archive -e mta-dev.mtaext",
    "build:mta:prd": "mbt build --mtar archive -e mta-prd.mtaext",
    "deploy:dev": "npm run build:mta:dev && cf deploy mta_archives/archive.mtar --retries 1",
    "deploy:prd": "npm run build:mta:prd && cf deploy mta_archives/archive.mtar --retries 1",
    "watch-mpt": "cds watch --open mpt/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-multi-step": "cds watch --open multistep/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-multi-log": "cds watch --open multilog/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-multi-log-hybrid": "cds watch --profile hybrid --open multilog/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-transfer": "cds watch --open transfer/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-outbounddelivery": "cds watch --open outbounddelivery/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-paymentreceipt": "cds watch --open paymentreceipt/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": "hana",
      "auth": {
        "kind": "xsuaa"
      }
    },
    "server": {
      "welcome": true,
      "body_parser": {
        "limit": "10mb"
      }
    },
    "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/mpt",
    "app/multi-step",
    "app/multi-log",
    "app/transfer",
    "app/outbounddelivery",
    "app/paymentreceipt",
    "app/bank",
    "app/dn-rel",
    "app/so-rel",
    "app/transfer",
    "app/pitransfer",
    "app/socreate",
    "app/sochange",
    "app/dninfo"
  ],
  "devDependencies": {
    "cds-plugin-ui5": "^0.13.0"
  }
}
}
