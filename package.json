{
  "name": "zictm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^3.26.4",
    "@sap-cloud-sdk/http-client": "^3.26.4",
    "@sap-cloud-sdk/resilience": "^3.26.4",
    "@sap-cloud-sdk/util": "^3.26.4",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9.8.4",
    "@sap/xssec": "^4",
    "axios": "^1.15.0"
  },
  "scripts": {
    "start": "node node_modules/@sap/cds-dk/bin/cds.js run",
    "undeploy": "cf undeploy zictm --delete-services --delete-service-keys --delete-service-brokers",
    "build": "cds build --production",
    "build:mta": "mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-mpt": "cds watch --open mpt/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-multi-step": "cds watch --open multistep/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": "hana",
      "auth": {
        "kind": "xsuaa"
      },
      "API_PRODUCT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PRODUCT_SRV",
        "url": "https://my201417.s4hana.sapcloud.cn/sap/opu/odata/sap/API_PRODUCT_SRV",
        "csrf": false
      },
      "API_MATERIAL_DOCUMENT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_MATERIAL_DOCUMENT_SRV",
        "url": "https://my201417.s4hana.sapcloud.cn/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV",
        "csrf": false
      }
    },
    "server": {
      "welcome": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/mpt",
    "app/mpt",
    "app/multi-step"
  ]
}
