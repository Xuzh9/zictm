_schema-version: 3.3.0
ID: zictm-prd
extends: zictm
parameters:
  domain: btp-prd.sunlu3d.cn
modules:
  - name: zictm-srv
    parameters:
      disk-quota: 2048M
      memory: 256M
      routes:
      - route: "zictm-srv.btp-prd.sunlu3d.cn"
      idle-routes:
      - idle-route: "zictm-srv-idle.btp-prd.sunlu3d.cn"
    provides:
      - name: srv-api
        properties:
          srv-url: https://zictm-srv.btp-prd.sunlu3d.cn
  - name: zictm
    parameters:
      disk-quota: 2048M
      memory: 256M
      routes:
      - route: "zictm.btp-prd.sunlu3d.cn"
      idle-routes:
      - idle-route: "zictm-idle.btp-prd.sunlu3d.cn"
resources:
  - name: zictm-auth
    parameters:
      service: xsuaa
      service-plan: application
      path: ./xs-security.json
      config:
        xsappname: zictm-prd
        role-collections:
          - name: zictm-prd_Administrators
            description: zictm PRD Administrators
            role-template-references:
              - "$XSAPPNAME.Administrators"